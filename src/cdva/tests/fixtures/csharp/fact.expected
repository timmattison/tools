. using Xunit;
. 
. namespace Example.Calc
. {
.     public class Calculator
.     {
.         public int Add(int a, int b)
.         {
.             return a + b;
.         }
.     }
. 
.     public class AdditionFacts
.     {
T         [Fact]
T         public void AddsTwoNumbers()
T         {
T             Assert.Equal(3, new Calculator().Add(1, 2));
T         }
.     }
. }
