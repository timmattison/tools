. defmodule Calc do
.   def add(a, b) do
.     a + b
.   end
. end
. 
. defmodule CalcChecks do
T   describe "add/2" do
T     test "adds two numbers" do
T       assert Calc.add(1, 2) == 3
T     end
T 
T     property "adds in either order" do
T       assert Calc.add(1, 2) == Calc.add(2, 1)
T     end
T   end
. end
