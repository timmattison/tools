# UniFi API Configuration
#
# Copy this file to .env and fill in your values. `ufa` loads .env from the
# working directory before it parses arguments, so anything set here behaves
# exactly like an exported environment variable.
#
# A .env file holds your API keys in cleartext. For anything longer-lived than
# local development, prefer `ufa config setup`, which can keep the keys in
# 1Password and reference them from ~/.config/ufa/config.toml — see README.md.
#
# Precedence: command-line flag > environment (including this file) > config file.

# UniFi controller URL (required unless set in the config file)
UNIFI_URL=https://192.168.1.1

# Controller API key, for the sites/devices/clients/vouchers/info commands.
# Generate it in Settings -> Control Plane -> Integrations.
UNIFI_API_KEY=your_api_key_here

# Site Manager (cloud) API key, for the `ufa cloud` commands.
# Generate it in the API section at https://unifi.ui.com — it is shown once.
# UNIFI_SITE_MANAGER_API_KEY=your_site_manager_api_key_here

# Skip TLS certificate verification, for controllers with a self-signed
# certificate. Accepts true/false, 1/0, yes/no, on/off. Any other value is
# rejected rather than ignored.
# UNIFI_INSECURE=true
