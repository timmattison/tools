#!/usr/bin/env bash
# Reject commits that fail formatting, linting, or the test suite. The gates
# only run when a staged change touches a Rust file (see the trigger regex
# below), so a commit that touches no Rust never pays for the Rust toolchain.
# Two blocks below are the deliberate exceptions. A commit that stages
# README.md or TLDR.md, or a file of plugins/ic-inline, and no Rust file runs
# one Rust test target. The guard that protects the two Markdown indexes, and
# the test that holds the plugin to the output of ic, live in the Rust suite.
#
# The four Rust gates live in scripts/rust-checks.sh, and the checks of the
# Claude Code plugins live in scripts/plugin-checks.sh. CI runs both scripts.
# Each script is the one list of its checks: add a new check there, not here.
# The header of each script gives its checks and the reason for each one.
#
# The trigger regex also matches rustfmt.toml and rust-toolchain.toml at the
# repo root: a commit that bumps the toolchain or style config is the scenario
# most likely to introduce drift, so the gate must run on those changes too.
# It also matches scripts/rust-checks.sh, because a change to the list of
# checks must run the changed list.
#
# All four checks read the WORKING TREE, not the staged index, so a partially
# staged file (or one staged then edited) is checked in its on-disk state, not
# the version being committed. This is a deliberate trade-off: index-only
# checking (stash --keep-index dances) is fragile, and the workspace-wide cargo
# commands cannot operate on a virtual index anyway.
set -euo pipefail

# shellcheck source=scripts/without-git-environment.sh
. "$(dirname "$0")/../scripts/without-git-environment.sh"

# Each path that the commit adds, deletes, changes, or gives a new type (a file
# that becomes a symbolic link), one on each line. The list takes no
# --diff-filter, because a status that a filter leaves out hides its path from
# each block that reads the list. git diff finds renames by default, and
# --name-only then prints only the new path of a move. --no-renames shows a
# move as a deletion of the old path and an addition of the new path, so a
# block that matches the old path sees a move out of it. The index block, the
# plugin block and the ic-inline block below read this list.
staged_paths_with_deletions() {
    git diff --cached --name-only --no-renames
}

if git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.rs$|(^|/)Cargo\.(toml|lock)$|^(rustfmt|rust-toolchain)\.toml$|^scripts/rust-checks\.sh$'; then
    echo "pre-commit: running scripts/rust-checks.sh"
    ./scripts/rust-checks.sh
    rust_gate_ran=yes
fi

# Both tool indexes are Markdown, and the Rust gate above triggers on Rust files
# only, so a commit that edits README.md or TLDR.md and nothing else would run
# no gate at all. The guard that holds every binary in both indexes
# (repo_guards::tool_index) lives in the Rust suite, so such a commit has to
# name it directly.
#
# This is what closes the direction the guard cannot otherwise reach. Adding a
# crate touches a Cargo.toml and so pays the Rust gate above, which runs the
# guard; REMOVING a tool's entry from an index touches Markdown alone. Issue
# #311, which clears the ~563-violation markdownlint backlog, is a bulk rewrite
# of exactly that shape.
#
# It runs the one test target rather than the workspace suite, so it costs a
# fraction of the Rust block. The rust_gate_ran guard keeps a commit that
# touches Rust and an index from running the same test twice.
#
# The block reads staged_paths_with_deletions: deleting or moving an index is
# the fault this catches, not only editing one. The same
# `without_git_environment` as each cargo command of scripts/rust-checks.sh
# keeps the two symmetric.
if [ "${rust_gate_ran:-}" != yes ] &&
    staged_paths_with_deletions | grep -qE '^(README|TLDR)\.md$'; then
    echo "pre-commit: running cargo test -p repo-guards --test tool_index_coverage"
    without_git_environment cargo test -p repo-guards --test tool_index_coverage
fi

# The Claude Code plugins under plugins/ are TypeScript, and the Rust gate above
# reads none of them. A commit that stages a file of a plugin, the marketplace
# file that lists them, or scripts/plugin-checks.sh, therefore runs
# scripts/plugin-checks.sh. CI runs the same script. Its header gives each
# check and the reason for it.
#
# The block reads staged_paths_with_deletions, as the index gate above does:
# deleting a file of a plugin, or moving it out, can break the plugin as surely
# as an edit can.
if staged_paths_with_deletions | grep -qE '^(plugins/|\.claude-plugin/)|^scripts/plugin-checks\.sh$'; then
    echo "pre-commit: running scripts/plugin-checks.sh"
    ./scripts/plugin-checks.sh
fi

# The test emit_rgba_prints_the_json_that_the_plugin_tests_hold of ic reads
# plugins/ic-inline/tests/fixture.png and the FIXTURE_JSON of the plugin tests,
# and holds that copy to the real output of `ic --emit-rgba`. The sandbox of
# `claude plugin test` runs no process, so the plugin block above cannot see a
# stale copy. Without this block, such a commit passes, and the next commit
# that stages a Rust file fails in a change that did not cause it.
#
# It runs the whole test target, not the one test by name: a filter that
# matches no test passes, so a rename of the test would leave the block a
# no-op. The rust_gate_ran guard keeps a commit that touches Rust from running
# the target twice, because the workspace tests hold it. The block reads
# staged_paths_with_deletions, because the test names the old paths, so a
# deletion or a move of a file of the plugin breaks it as an edit can.
if [ "${rust_gate_ran:-}" != yes ] &&
    staged_paths_with_deletions | grep -qE '^plugins/ic-inline/'; then
    echo "pre-commit: running cargo test -p ic --test emit-rgba"
    without_git_environment cargo test -p ic --test emit-rgba
fi
